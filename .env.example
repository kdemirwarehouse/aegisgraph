# AegisGraph ortam değişkenleri — .env olarak kopyalayın
AEGIS_ENVIRONMENT=dev
AEGIS_LOG_LEVEL=INFO

# AEGIS_DATABASE__URL=sqlite:///C:/path/to/aegisgraph.db

AEGIS_GENERATOR__SEED=42
AEGIS_GENERATOR__N_CUSTOMERS=2000
AEGIS_GENERATOR__SIMULATION_DAYS=30

AEGIS_RISK__ALERT_SCORE=0.70
AEGIS_RISK__BLOCK_SCORE=0.90

# Tanımlanırsa POST/PATCH uçları X-API-Key başlığı ister (boş = demo modu)
# AEGIS_API__WRITE_API_KEY=degistir-beni
