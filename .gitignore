# Veri (dizin yapısı .gitkeep ile korunur)
data/*
!data/raw/
data/raw/*
!data/raw/.gitkeep
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Ortam / gizli bilgiler
.env

# Model artefaktları — ikili dosyalar yeniden üretilebilir; rapor ve metrikler versiyonlanır
artifacts/*
!artifacts/report.md
!artifacts/metrics.json
!artifacts/feature_importance.csv
*.pkl
*.joblib

# Dokümantasyon görselleri takip edilir
!docs/assets/*.png

# IDE
.vscode/
.idea/
